# Database - use postgres for host when running in Docker
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qao_inmate
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qao_inmate  # fallback

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# JWT (use strong secret in production)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Debug
DEBUG=false

# CourtListener (Federal Case Search)
COURTLISTENER_BASE_URL=https://www.courtlistener.com
# COURTLISTENER_API_TOKEN=your-token  # optional for dev
FED_CASE_CACHE_TTL_DAYS=30
FED_CASE_SYNC_STALE_DAYS=7
COURTLISTENER_RATE_LIMIT_RPS=2
